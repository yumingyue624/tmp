 Status HixlCSClient::BatchTransferTask(bool is_get, uint32_t list_num, const HixlOneSideOpDesc *desc_list) const {
+  const uint64_t total_begin = PerfNowUs();
+  uint64_t first_nbi_us = 0U;
+  uint64_t max_nbi_us = 0U;
+  uint32_t max_nbi_index = 0U;
   for (uint32_t i = 0; i < list_num; i++) {
     void *dst = is_get ? desc_list[i].local_buf : desc_list[i].remote_buf;
     const void *src = is_get ? desc_list[i].remote_buf : desc_list[i].local_buf;
+    const uint64_t nbi_begin = PerfNowUs();
     auto ret = TransferWithRetry(is_get, client_channel_handle_, dst, src, desc_list[i].len);
+    const uint64_t nbi_us = PerfNowUs() - nbi_begin;
+    if (i == 0U) { first_nbi_us = nbi_us; }
+    if (nbi_us > max_nbi_us) {
+      max_nbi_us = nbi_us;
+      max_nbi_index = i;
+    }
     if (ret != SUCCESS) {
       return FAILED;
     }
   }
+  const uint64_t nbi_done = PerfNowUs();
+  const uint64_t fence_begin = PerfNowUs();
   int32_t hccl_ret = HcommProxy::ChannelFenceOnThread(static_cast<ThreadHandle>(0), client_channel_handle_);
+  const uint64_t fence_done = PerfNowUs();
   if (hccl_ret != SUCCESS) {
     HIXL_LOGE(FAILED, "[HixlClient] HcommChannelFenceOnThread failed, client_channel_handle_ is %lu, hccl_ret is %d.",
               client_channel_handle_, hccl_ret);
     return FAILED;
   }
+  std::fprintf(stderr,
+               "[HIXL_PERF] event=host_batch_task is_get=%d list_num=%u nbi_loop_us=%lu "
+               "first_nbi_us=%lu max_nbi_us=%lu max_nbi_index=%u fence_us=%lu total_us=%lu\n",
+               static_cast<int32_t>(is_get), list_num, nbi_done - total_begin, first_nbi_us, max_nbi_us,
+               max_nbi_index, fence_done - fence_begin, fence_done - total_begin);
   return SUCCESS;
 }
