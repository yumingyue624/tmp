   return SUCCESS;
 }
@@
 Status CommChannel::IssueHcclBatch(TransferOp operation, const std::vector<TransferOpDesc> &op_descs,
                                    aclrtStream stream) {
+  const uint64_t total_begin = ChannelPerfNowUs();
@@
   auto trans_func = [this, operation, &stream](HcclOneSideOpDesc *descs, uint32_t desc_num) -> Status {
+    const uint64_t hccl_begin = ChannelPerfNowUs();
     HcclResult ret = HCCL_SUCCESS;
@@
     }
+    const uint64_t hccl_done = ChannelPerfNowUs();
+    std::fprintf(stderr, "[HIXL_PERF] event=hccl_batch op=%d desc_num=%u hccl_us=%lu status=%d\n",
+                 static_cast<int32_t>(operation), desc_num, hccl_done - hccl_begin, static_cast<int32_t>(ret));
@@
   };
   BufferedTransfer transfer(trans_func);
   ADXL_CHK_STATUS_RET(transfer.Put(op_descs), "Failed to batch transfer");
+  const uint64_t total_done = ChannelPerfNowUs();
+  std::fprintf(stderr,
+               "[HIXL_PERF] event=issue_hccl_batch op=%d list_num=%zu total_us=%lu\n",
+               static_cast<int32_t>(operation), op_descs.size(), total_done - total_begin);
