diff --git a/src/hixl/engine/comm_engine.cc b/src/hixl/engine/comm_engine.cc
--- a/src/hixl/engine/comm_engine.cc
+++ b/src/hixl/engine/comm_engine.cc
@@
 #include "comm_engine.h"
+#include <chrono>
+#include <cstdio>
 #include "common/hixl_checker.h"
 
 namespace hixl {
+namespace {
+uint64_t CommPerfNowUs() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+}  // namespace
@@
 Status CommEngine::TransferAsync(const AscendString &remote_engine, TransferOp operation,
                                  const std::vector<TransferOpDesc> &op_descs, const TransferArgs &optional_args,
                                  TransferReq &req) {
+  const uint64_t total_begin = CommPerfNowUs();
   HIXL_CHK_BOOL_RET_STATUS(!op_descs.empty(), PARAM_INVALID, "[CommEngine] TransferAsync failed, op_descs is empty.");
   (void)optional_args;
   adxl::TransferOp adxl_operation = static_cast<adxl::TransferOp>(operation);
   std::vector<adxl::TransferOpDesc> adxl_op_descs;
+  adxl_op_descs.reserve(op_descs.size());
   for (const auto &op_desc : op_descs) {
     adxl_op_descs.emplace_back(adxl::TransferOpDesc{op_desc.local_addr, op_desc.remote_addr, op_desc.len});
   }
+  const uint64_t desc_done = CommPerfNowUs();
   adxl::TransferArgs adxl_optional_args;
-  return adxl_inner_engine_.TransferAsync(remote_engine, adxl_operation, adxl_op_descs, adxl_optional_args, req);
+  const Status ret = adxl_inner_engine_.TransferAsync(remote_engine, adxl_operation, adxl_op_descs,
+                                                       adxl_optional_args, req);
+  const uint64_t total_done = CommPerfNowUs();
+  std::fprintf(stderr,
+               "[HIXL_PERF] event=comm_engine_async op=%d list_num=%zu desc_build_us=%lu "
+               "inner_us=%lu total_us=%lu status=%d\n",
+               static_cast<int32_t>(operation), op_descs.size(), desc_done - total_begin,
+               total_done - desc_done, total_done - total_begin, static_cast<int32_t>(ret));
+  return ret;
 }
diff --git a/src/llm_datadist/adxl/adxl_inner_engine.cc b/src/llm_datadist/adxl/adxl_inner_engine.cc
--- a/src/llm_datadist/adxl/adxl_inner_engine.cc
+++ b/src/llm_datadist/adxl/adxl_inner_engine.cc
@@
 #include "adxl_inner_engine.h"
+#include <chrono>
+#include <cstdio>
 #include "acl/acl.h"
@@
 namespace adxl {
 namespace {
+uint64_t AdxlPerfNowUs() {
+  return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
@@
 Status AdxlInnerEngine::TransferAsync(const AscendString &remote_engine, TransferOp operation,
                                       const std::vector<TransferOpDesc> &op_descs, const TransferArgs &optional_args,
                                       TransferReq &req) {
+  const uint64_t total_begin = AdxlPerfNowUs();
   hixl::TemporaryRtContext with_context(aclrt_context_);
+  const uint64_t context_done = AdxlPerfNowUs();
   if (user_config_channel_pool_ || auto_connect_) {
     (void)ConnectWhenTransfer(remote_engine, kConnectWhenTransferTimeout);
   }
+  const uint64_t connect_done = AdxlPerfNowUs();
   auto channel = channel_manager_.GetChannel(ChannelType::kClient, remote_engine.GetString());
+  const uint64_t channel_done = AdxlPerfNowUs();
@@
   Status trans_status = channel->TransferAsync(operation, op_descs, optional_args, req);
+  const uint64_t transfer_done = AdxlPerfNowUs();
@@
   std::lock_guard<std::mutex> lock(req2channel_mutex_);
   req_map_.emplace(id, transfer_info);
+  const uint64_t total_done = AdxlPerfNowUs();
+  std::fprintf(stderr,
+               "[HIXL_PERF] event=adxl_inner_async op=%d list_num=%zu context_us=%lu connect_us=%lu "
+               "get_channel_us=%lu channel_async_us=%lu tail_us=%lu total_us=%lu\n",
+               static_cast<int32_t>(operation), op_descs.size(), context_done - total_begin,
+               connect_done - context_done, channel_done - connect_done, transfer_done - channel_done,
+               total_done - transfer_done, total_done - total_begin);
   return SUCCESS;
 }
diff --git a/src/llm_datadist/adxl/comm_channel.cc b/src/llm_datadist/adxl/comm_channel.cc
